<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BaseAppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="homeAsUpIndicator">@drawable/ic_left_arrow</item>
        <item name="android:homeAsUpIndicator">@drawable/ic_left_arrow</item>
        <item name="colorPrimary">@color/rare_3</item>
        <item name="colorPrimaryDark">@color/blue_600</item>
        <item name="colorSecondary">?attr/colorPrimary</item>
        <item name="materialAlertDialogTheme">@style/ArkAlertTheme</item>
        <item name="bottomSheetDialogTheme">@style/ArkSheetTheme</item>
        <item name="capsuleAccentContainer">@color/tool_recruit_container</item>
        <item name="capsuleAccentContent">@color/tool_recruit_icon</item>
        <item name="materialCardViewStyle">@style/ArkContentCardSurface</item>
        <item name="materialSwitchStyle">@style/Widget.ArkScreen.Switch</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Body2</item>
        <item name="textAppearanceHeadline4">@style/TextAppearance.Headline4</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.Subtitle2</item>
    </style>

    <style name="AppTheme" parent="BaseAppTheme">
        <item name="colorOnSurface">@color/day_text_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/day_text_primary</item>
        <item name="chipBackgroundColor">@color/cyan_trans</item>
    </style>

    <style name="BaseEndfieldAppTheme" parent="AppTheme">
        <item name="capsuleAccentContainer">@color/endfield_accent_container</item>
        <item name="capsuleAccentContent">@color/endfield_on_surface_accent</item>
        <item name="colorPrimaryDark">@color/endfield_primary_dark</item>
        <item name="colorSecondary">@color/endfield_primary</item>
        <item name="colorOnPrimary">@color/grey_900</item>
    </style>

    <style name="AppTheme.Endfield" parent="BaseEndfieldAppTheme">
        <item name="colorPrimary">@color/endfield_on_surface_accent</item>
    </style>
    
    <style name="TextAppearance.Headline4" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextView.Clickable" parent="Widget.AppCompat.TextView">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="TextView.Headline" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">@dimen/page_horizontal_spacing</item>
        <item name="android:paddingEnd">@dimen/page_horizontal_spacing</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">20dp</item>
    </style>

    <style name="Widget.ArkScreen.MetadataCapsule" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_compact_capsule</item>
        <item name="android:minHeight">26dp</item>
        <item name="android:backgroundTint">@color/status_neutral_container</item>
        <item name="android:textColor">@color/status_neutral_content</item>
        <item name="android:textSize">11.2sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">9.6dp</item>
        <item name="android:paddingEnd">9.6dp</item>
        <item name="android:paddingTop">4.8dp</item>
        <item name="android:paddingBottom">4.8dp</item>
    </style>

    <style name="Widget.ArkScreen.StatusCapsule" parent="Widget.ArkScreen.MetadataCapsule" />

    <style name="Widget.ArkScreen.StatusCapsule.Accent">
        <item name="android:backgroundTint">?attr/capsuleAccentContainer</item>
        <item name="android:textColor">?attr/capsuleAccentContent</item>
    </style>

    <style name="Widget.ArkScreen.StatusCapsule.Warning">
        <item name="android:backgroundTint">@color/status_warning_container</item>
        <item name="android:textColor">@color/status_warning_content</item>
    </style>

    <!-- Information variants share the homepage capsule geometry. -->
    <style name="Widget.ArkScreen.MetadataCapsule.Supporting" parent="Widget.ArkScreen.MetadataCapsule">
        <item name="android:backgroundTint">@color/inline_chip_background</item>
        <item name="android:textColor">@color/inline_chip_text</item>
    </style>


    <style name="Widget.ArkScreen.InlineAction" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="backgroundTint">@color/inline_chip_background</item>
        <item name="android:textColor">@color/inline_chip_text</item>
        <item name="cornerRadius">7dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="ArkContentCardSurface" parent="Widget.MaterialComponents.CardView">
        <item name="strokeWidth">0dp</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/app_surface</item>
    </style>

    <style name="CardViewContent" parent="ArkContentCardSurface">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/card_vertical_spacing</item>
        <item name="android:layout_marginStart">@dimen/page_horizontal_spacing</item>
        <item name="android:layout_marginEnd">@dimen/page_horizontal_spacing</item>
    </style>


    <style name="TextAppearance.Subtitle2" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.Body1" parent="TextAppearance.MaterialComponents.Body1">
    </style>

    <style name="TextAppearance.Body2" parent="TextAppearance.MaterialComponents.Body2">
    </style>

    <style name="PreferenceRow">
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>
    <style name="PreferenceRow.Switch">
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
    <style name="PreferenceRow.Detail">
        <item name="android:minHeight">@dimen/preference_detail_height</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>
    <style name="PreferenceRowIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="tint">@color/function_text_secondary</item>
    </style>
    <style name="PreferenceRowTitle" parent="PreferenceTitle">
        <item name="android:textColor">@color/function_text_primary</item>
        <item name="android:textStyle">normal</item>
    </style>
    <style name="PreferenceRowValue">
        <item name="android:textColor">@color/function_text_secondary</item>
        <item name="android:textSize">@dimen/preference_value_text_size</item>
    </style>
    <style name="PreferenceRowValue.Detail">
        <item name="android:textSize">13sp</item>
    </style>

    <style name="PreferenceTitle" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
    </style>


    <style name="Widget.ArkScreen.GachaPullProgress" parent="Widget.MaterialComponents.LinearProgressIndicator">
        <item name="android:layout_height">12dp</item>
        <item name="android:indeterminate">false</item>
        <item name="indicatorColor">@color/gacha_pull_green</item>
        <item name="trackColor">@color/gacha_pull_track</item>
        <item name="trackThickness">12dp</item>
        <item name="trackCornerRadius">6dp</item>
    </style>


    <style name="PreferenceHeader" parent="Widget.AppCompat.TextView">
        <item name="android:paddingEnd">@dimen/page_horizontal_spacing</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingStart">@dimen/page_horizontal_spacing</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceSubtitle2</item>
    </style>

    <style name="SectionTitleText" parent="Widget.AppCompat.TextView">
        <item name="android:textColor">@color/app_text_section</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="PageSectionTitle" parent="SectionTitleText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginStart">32dp</item>
        <item name="android:layout_marginEnd">32dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="CardSupportingText" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/app_text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Preference" parent="TextView.Clickable">
        <item name="android:padding">16dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAppearance">@style/PreferenceTitle</item>
    </style>

    <style name="RoundedImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">5dp</item>
    </style>

    <style name="TranslucentTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>


    <style name="CardViewChip" parent="ArkContentCardSurface">
        <item name="cardBackgroundColor">@color/operator_card_surface</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">5dp</item>
    </style>

    <style name="BottomNavigationViewStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconSize">20dp</item> <!-- 设置图标大小 -->
        <item name="itemTextAppearanceActive">@style/BottomNavigationTextStyle</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavigationTextStyle</item>
    </style>

    <style name="BottomNavigationTextStyle" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">12sp</item> <!-- 设置文字大小 -->
    </style>

    <!-- Compact actions displayed beside section headers. -->
    <style name="Widget.ArkScreen.SectionAction" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">5dp</item>
        <item name="iconSize">18dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.ArkScreen.SectionAction.Tonal">
        <item name="android:textColor">@color/on_sec_con</item>
        <item name="backgroundTint">@color/sec_con</item>
        <item name="iconTint">@color/on_sec_con</item>
    </style>

    <style name="Widget.ArkScreen.EmptyIllustration" parent="">
        <item name="android:layout_width">@dimen/empty_illustration_size</item>
        <item name="android:layout_height">@dimen/empty_illustration_size</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="Widget.ArkScreen.EmptyTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ArkScreen.EmptySummary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="Widget.ArkScreen.EmptyAction" parent="Widget.ArkScreen.SectionAction.Tonal">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>

    <style name="WidgetDenseText" parent="">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">-1dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="WidgetDenseSupportingText" parent="WidgetDenseText">
        <item name="android:textColor">#FFB8BBC3</item>
        <item name="android:textSize">9sp</item>
    </style>

    <style name="WidgetDenseSummaryText" parent="WidgetDenseSupportingText">
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#FFC8CBD2</item>
    </style>

    <style name="WidgetDensePrimaryText" parent="WidgetDenseText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetDenseDetailText" parent="WidgetDenseSupportingText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="WidgetDenseFooterText" parent="WidgetDenseSupportingText">
        <item name="android:layout_width">wrap_content</item>
    </style>

    <style name="Widget.ArkScreen.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:textAppearance">?attr/textAppearanceBody2</item>
        <item name="android:minHeight">48dp</item>
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
        <item name="trackDecorationTint">@color/switch_outline</item>
        <item name="thumbIconTint">?attr/colorOnSurface</item>
    </style>

    <style name="HomeCardHeading">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/home_text_primary</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="drawableTint">@color/function_text_secondary</item>
    </style>
    <style name="Widget.ArkScreen.ActionChip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/home_text_primary</item>
        <item name="chipIconTint">@color/home_text_primary</item>
        <item name="chipBackgroundColor">@color/status_neutral_container</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="chipIconSize">18dp</item>
        <item name="chipStartPadding">9dp</item>
        <item name="chipEndPadding">9dp</item>
        <item name="textStartPadding">2dp</item>
        <item name="textEndPadding">2dp</item>
        <item name="iconStartPadding">0dp</item>
        <item name="iconEndPadding">0dp</item>
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="chipMinTouchTargetSize">48dp</item>
        <item name="android:checkable">false</item>
    </style>
    <!-- Filtering changes state and colors, not the action capsule geometry. -->
    <style name="Widget.ArkScreen.FilterChip" parent="Widget.ArkScreen.ActionChip">
        <item name="android:checkable">true</item>
        <item name="chipIconVisible">false</item>
        <item name="checkedIconVisible">true</item>
        <item name="checkedIcon">@drawable/ic_mtrl_chip_checked_black</item>
        <item name="checkedIconTint">@color/capsule_filter_content</item>
        <item name="android:textColor">@color/capsule_filter_content</item>
        <item name="chipBackgroundColor">@color/capsule_filter_container</item>
    </style>
    <style name="ToolbarIconAction">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_gravity">end|center_vertical</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">13dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/home_text_primary</item>
    </style>
    <style name="HomePageCard" parent="CardViewContent"><item name="android:layout_marginTop">@dimen/home_page_spacing</item></style>
    <style name="Widget.ArkScreen.RecruitFilterChip" parent="Widget.ArkScreen.FilterChip">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/recruit_filter_chip_text</item>
        <item name="chipBackgroundColor">@color/recruit_filter_chip_background</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipStartPadding">6dp</item>
        <item name="chipEndPadding">6dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="android:checkable">true</item>
        <item name="textStartPadding">8dp</item>
        <item name="textEndPadding">6dp</item>
        <item name="checkedIconTint">@color/recruit_filter_chip_text</item>
        <item name="chipIconSize">24dp</item>
    </style>
    <style name="Widget.ArkScreen.RecruitResultChip" parent="Widget.ArkScreen.ActionChip">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipStartPadding">6dp</item>
        <item name="chipEndPadding">6dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="chipBackgroundColor">@color/recruit_tag_surface</item>
        <item name="android:textColor">@color/home_text_primary</item>
        <item name="textStartPadding">4dp</item>
        <item name="textEndPadding">4dp</item>
        <item name="chipIconVisible">true</item>
        <item name="checkedIconVisible">false</item>
    </style>
    <style name="Widget.ArkScreen.RecruitActionChip" parent="Widget.ArkScreen.ActionChip">
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="chipCornerRadius">16dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipBackgroundColor">@color/recruit_tag_surface</item>
        <item name="android:textColor">@color/status_neutral_content</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>
    <style name="Widget.ArkScreen.RecruitToggleChip" parent="Widget.ArkScreen.RecruitFilterChip">
        <item name="checkedIconVisible">true</item>
    </style>
    <style name="SaveFloatingActionButton" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">bottom|end</item>
        <item name="android:layout_margin">20dp</item>
        <item name="android:contentDescription">保存</item>
        <item name="srcCompat">@drawable/ic_widget_save</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ArkScreen.SaveCircle</item>
        <item name="tint">?attr/colorOnPrimary</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
    </style>

    <style name="ShapeAppearance.ArkScreen.SaveCircle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="RecoverySettingsSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/function_text_primary</item>
    </style>

    <style name="ListDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginEnd">20dp</item>
        <item name="android:background">@color/function_divider</item>
    </style>

    <style name="AccountSelectorBase">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="AccountSelectorName">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/home_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AccountSelectorIndicator">
        <item name="android:layout_width">12dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:src">@drawable/ic_function_select</item>
        <item name="tint">@color/home_text_secondary</item>
    </style>
    <!-- Shared image behavior; each business item controls its own frame size/padding. -->
    <style name="DetailItemIcon">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
</resources>
