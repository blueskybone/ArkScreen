<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blue_500</item>
        <item name="colorPrimaryDark">@color/blue_600</item>
        <item name="colorSecondary">?attr/colorPrimary</item>
        <item name="colorSurface">@color/day_surface</item>
        <item name="colorOnSurface">@color/day_text_primary</item>

        <item name="android:colorBackground">@color/day_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Body2</item>
        <item name="textAppearanceHeadline4">@style/TextAppearance.Headline4</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.Subtitle2</item>

        <item name="android:textColorPrimary">@color/day_text_primary</item>

        <item name="chipBackgroundColor">@color/cyan_trans</item>
    </style>
    
    <style name="TextAppearance.Headline4" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextView.Clickable" parent="Widget.AppCompat.TextView">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="TextView.Headline" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">@dimen/page_horizontal_spacing</item>
        <item name="android:paddingEnd">@dimen/page_horizontal_spacing</item>
        <item name="android:paddingTop">24dp</item>
        <item name="android:paddingBottom">20dp</item>
    </style>

    <style name="TextView.Headline3" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="PopupDownAnim" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/popup_enter</item>
        <item name="android:windowExitAnimation">@anim/popup_exit</item>
    </style>

    <style name="CardViewContent" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/card_vertical_spacing</item>
        <item name="android:layout_marginStart">@dimen/page_horizontal_spacing</item>
        <item name="android:layout_marginEnd">@dimen/page_horizontal_spacing</item>
        <item name="cardCornerRadius">15dp</item>
        <item name="cardElevation">0dp</item>
<!--        <item name="cardBackgroundColor">?attr/android:colorBackground</item>-->
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeWidth">1dp</item>
    </style>


    <style name="TextAppearance.Subtitle2" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.Body1" parent="TextAppearance.MaterialComponents.Body1">
    </style>

    <style name="TextAppearance.Body2" parent="TextAppearance.MaterialComponents.Body2">
    </style>

    <style name="PreferenceTitle" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
    </style>


    <style name="GachaProgressBar" parent="Widget.AppCompat.ProgressBar.Horizontal">
        <item name="android:indeterminateOnly">false</item>
        <item name="android:minHeight">30dp</item>
        <item name="android:progressDrawable">@drawable/progress_indeterminate_horizontal</item>
        <item name="android:maxHeight">30dp</item>
    </style>

    <style name="PreferenceHeader" parent="Widget.AppCompat.TextView">
        <item name="android:paddingEnd">@dimen/page_horizontal_spacing</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingStart">@dimen/page_horizontal_spacing</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textAppearance">?attr/textAppearanceSubtitle2</item>
    </style>

    <style name="Preference" parent="TextView.Clickable">
        <item name="android:padding">16dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAppearance">@style/PreferenceTitle</item>
    </style>

    <style name="RoundedImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">5dp</item>
    </style>

    <style name="CircularImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="TranslucentTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>


    <style name="CardViewChip" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">5dp</item>
        <item name="android:layout_margin">5dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="BottomNavigationViewStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconSize">20dp</item> <!-- 设置图标大小 -->
        <item name="itemTextAppearanceActive">@style/BottomNavigationTextStyle</item>
        <item name="itemTextAppearanceInactive">@style/BottomNavigationTextStyle</item>
    </style>

    <style name="BottomNavigationTextStyle" parent="TextAppearance.AppCompat.Caption">
        <item name="android:textSize">12sp</item> <!-- 设置文字大小 -->
    </style>

    <style name="Theme.ChipOverlay" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorOnSurface">@color/on_sec_con</item>
        <item name="colorOutline">@color/on_sec_con</item>
        <item name="colorSurface">@color/day_surface</item>
    </style>

    <style name="Widget.MyApp.Chip.Assist" parent="Widget.Material3.Chip.Assist">
        <item name="android:theme">@style/Theme.ChipOverlay</item>
        <item name="chipStartPadding">4dp</item>
        <item name="chipEndPadding">4dp</item>
        <item name="textStartPadding">4dp</item>
        <item name="textEndPadding">4dp</item>
    </style>

<!--    <style name="Theme.ChipOverlayError" parent="Theme.Material3.DayNight.NoActionBar">-->
<!--    </style>-->

<!--    <style name="Widget.MyApp.Chip.Error" parent="Widget.Material3.Chip.Assist">-->
<!--        <item name="android:theme">@style/Theme.ChipOverlayError</item>-->
<!--    </style>-->

    <!-- Compact actions displayed beside section headers. -->
    <style name="Widget.ArkScreen.SectionAction" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">36dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">5dp</item>
        <item name="iconSize">18dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.ArkScreen.SectionAction.Tonal">
        <item name="android:textColor">@color/on_sec_con</item>
        <item name="backgroundTint">@color/sec_con</item>
        <item name="iconTint">@color/on_sec_con</item>
    </style>

    <style name="Widget.ArkScreen.SectionAction.Outlined" parent="Widget.ArkScreen.SectionAction">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="iconTint">?attr/colorPrimary</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.ArkScreen.EmptyIllustration" parent="">
        <item name="android:layout_width">@dimen/empty_illustration_size</item>
        <item name="android:layout_height">@dimen/empty_illustration_size</item>
        <item name="android:contentDescription">@null</item>
    </style>

    <style name="Widget.ArkScreen.EmptyTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ArkScreen.EmptySummary" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="Widget.ArkScreen.EmptyAction" parent="Widget.ArkScreen.SectionAction.Tonal">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>

    <style name="Widget.ArkScreen.StatusChip" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">24dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_asset_stat_chip</item>
    </style>

    <style name="Widget.ArkScreen.TableHeaderText" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/on_sec_con</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="Widget.ArkScreen.AssetStatCell" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.ArkScreen.AssetStatValue" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ArkScreen.AssetStatChip" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_asset_stat_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/on_sec_con</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.ArkScreen.MetadataChip" parent="Widget.MyApp.Chip.Assist">
        <item name="android:minHeight">28dp</item>
        <item name="android:textSize">11sp</item>
        <item name="chipCornerRadius">14dp</item>
        <item name="chipMinHeight">28dp</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="textStartPadding">0dp</item>
        <item name="textEndPadding">0dp</item>
    </style>

    <style name="Widget.ArkScreen.MetadataChip.Primary" parent="Widget.ArkScreen.MetadataChip">
        <item name="android:textColor">@color/tool_recruit_icon</item>
        <item name="chipBackgroundColor">@color/tool_recruit_container</item>
    </style>

    <style name="Widget.ArkScreen.MetadataChip.Neutral" parent="Widget.ArkScreen.MetadataChip">
        <item name="android:textColor">@color/recruit_metadata_chip_text</item>
        <item name="chipBackgroundColor">@color/recruit_metadata_chip_background</item>
    </style>


    <style name="WidgetDenseSummaryText">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">-1dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#FFC8CBD2</item>
        <item name="android:textSize">9sp</item>
    </style>

    <style name="WidgetDensePrimaryText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">-1dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WidgetDenseDetailText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">-1dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#FFB8BBC3</item>
        <item name="android:textSize">9sp</item>
    </style>

    <style name="WidgetDenseFooterText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">-1dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#FFB8BBC3</item>
        <item name="android:textSize">9sp</item>
    </style>

</resources>
