<resources>
    <style name="AppTheme.About" parent="AppTheme">
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@style/AboutWindowFade</item>
    </style>

    <style name="AboutWindowFade" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/about_fade_in</item>
        <item name="android:windowExitAnimation">@anim/about_fade_out</item>
    </style>
</resources>
