<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cyan_500</item>
        <item name="colorPrimaryDark">@color/cyan_700</item>
        <item name="colorSecondary">?attr/colorPrimary</item>
        <item name="colorSurface">@color/grey_900</item>
        <item name="colorOnSurface">@color/dark_on_surface</item>

        <item name="android:textColorPrimary">@color/dark_on_surface</item>

        <item name="windowActionModeOverlay">true</item>

        <item name="android:statusBarColor">@color/transparent</item>
        <item name="textAppearanceBody1">@style/TextAppearance.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.Body2</item>
        <item name="textAppearanceHeadline4">@style/TextAppearance.Headline4</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.Subtitle2</item>
    </style>
    <style name="CardViewContent" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="cardCornerRadius">15dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="CardViewChip" parent="Widget.MaterialComponents.CardView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardCornerRadius">5dp</item>
        <item name="android:layout_margin">5dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <style name="Theme.ChipOverlay" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorOnSurface">@color/dark_on_surface</item>
        <item name="colorOutline">@color/on_sec_con</item>
        <item name="colorSurface">@color/grey_900</item>
        <item name="chipIconTint">@color/dark_on_surface</item>
    </style>

    <style name="Widget.MyApp.Chip.Assist" parent="Widget.Material3.Chip.Assist">
        <item name="android:theme">@style/Theme.ChipOverlay</item>
        <item name="chipStartPadding">4dp</item>
        <item name="chipEndPadding">4dp</item>
        <item name="textStartPadding">4dp</item>
        <item name="textEndPadding">4dp</item>
    </style>


</resources>
