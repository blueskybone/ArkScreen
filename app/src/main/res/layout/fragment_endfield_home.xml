<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="?attr/actionBarSize">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/GameSelector"
                style="@style/TextView.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:text="@string/game_endfield" />

            <TextView
                android:id="@+id/CurrentAccount"
                style="@style/TextView.Headline3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center"
                android:clickable="true"
                android:drawablePadding="10dp"
                android:maxWidth="200dp"
                android:padding="20dp"
                android:textColor="?attr/colorPrimary"
                app:drawableRightCompat="@drawable/ic_exchange"
                app:drawableTint="?attr/colorOnBackground" />
        </FrameLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/BannerCard"
            style="@style/CardViewContent"
            android:layout_height="120dp"
            android:visibility="gone">

            <com.blueskybone.arkscreen.ui.common.view.NestedScrollableHost
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/TitleBanner"
                    android:layout_width="match_parent"
                    android:layout_height="120dp" />
            </com.blueskybone.arkscreen.ui.common.view.NestedScrollableHost>

            <LinearLayout
                android:id="@+id/BannerIdc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|bottom"
                android:gravity="center"
                android:orientation="horizontal" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/PreferenceHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/real_time_data" />

        <com.google.android.material.card.MaterialCardView
            style="@style/CardViewContent"
            android:clickable="false"
            android:focusable="false">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:text="@string/endfield_home_pending" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/PreferenceHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/core_data" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/CoreAssets"
                layout="@layout/home_core_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/CoreGacha"
                layout="@layout/home_core_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            style="@style/PreferenceHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/tools" />

        <com.google.android.material.card.MaterialCardView
            style="@style/CardViewContent"
            android:clickable="false"
            android:focusable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="10dp">

                <include
                    android:id="@+id/GameStarter"
                    layout="@layout/chip_round"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/Attendance"
                    layout="@layout/chip_round"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/AccountManager"
                    layout="@layout/chip_round"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/AnnounceTitle"
            style="@style/PreferenceHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/announcement" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/AnnounceCard"
            style="@style/CardViewContent">

            <TextView
                android:id="@+id/Announce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
