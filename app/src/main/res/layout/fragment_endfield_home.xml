<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="?attr/actionBarSize">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/GameSelector"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/game_endfield"
                        android:textAppearance="?attr/textAppearanceHeadline6"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/SwitchGame"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="2dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/switch_game"
                        android:padding="9dp"
                        android:src="@drawable/ic_update"
                        app:tint="?attr/colorPrimary" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/DefaultStartup"
                    style="@style/Widget.ArkScreen.InlineAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/set_default_startup_page" />


            </LinearLayout>


            <TextView
                android:id="@+id/CurrentAccount"
                style="@style/TextView.Headline3"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="end"
                android:clickable="true"
                android:drawablePadding="10dp"
                android:gravity="center_vertical"
                android:maxWidth="200dp"
                android:paddingStart="12dp"
                android:paddingEnd="20dp"
                android:textColor="@color/endfield_on_surface_accent"
                app:drawableRightCompat="@drawable/ic_exchange"
                app:drawableTint="?attr/colorOnBackground" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/BannerCard"
            style="@style/CardViewContent"
            android:layout_height="120dp"
            android:visibility="gone">

            <com.blueskybone.arkscreen.ui.common.view.NestedScrollableHost
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/TitleBanner"
                    android:layout_width="match_parent"
                    android:layout_height="120dp" />
            </com.blueskybone.arkscreen.ui.common.view.NestedScrollableHost>

            <LinearLayout
                android:id="@+id/BannerIdc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|bottom"
                android:gravity="center"
                android:orientation="horizontal" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/PreferenceHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/real_time_data" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/RealTimeData"
            style="@style/CardViewContent"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <include
                android:id="@+id/EfStaminaCard"
                layout="@layout/card_ap_cache" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/PreferenceHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/core_data" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/CoreAssets"
                layout="@layout/home_core_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/CoreGacha"
                layout="@layout/home_core_tile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            style="@style/PreferenceHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/tools" />

        <com.google.android.material.card.MaterialCardView
            style="@style/CardViewContent"
            android:clickable="false"
            android:focusable="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="10dp">

                <include
                    android:id="@+id/GameStarter"
                    layout="@layout/chip_round"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/Attendance"
                    layout="@layout/chip_round"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <include
                    android:id="@+id/AccountManager"
                    layout="@layout/chip_round"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/AnnounceTitle"
            style="@style/PreferenceHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/announcement" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/AnnounceCard"
            style="@style/CardViewContent">

            <TextView
                android:id="@+id/Announce"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
