<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
        android:layout_height="wrap_content"
    android:orientation="vertical">
    <com.google.android.material.card.MaterialCardView style="@style/CardViewContent"
        android:layout_marginTop="@dimen/card_vertical_spacing">
        <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <com.google.android.material.imageview.ShapeableImageView android:id="@+id/Avatar" android:layout_width="44dp" android:layout_height="44dp" android:layout_marginEnd="12dp" android:scaleType="centerCrop" android:contentDescription="@null" app:shapeAppearanceOverlay="@style/RoundedImageView" />
                <include android:id="@+id/AccountSelector" layout="@layout/card_account_selector" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="8dp" android:background="@color/function_divider" />
            <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
            android:orientation="horizontal">
                <TextView android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="@string/assets_owned" style="@style/HomeCardHeading" />
                <TextView android:id="@+id/Owned" android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" android:textSize="30sp" android:textStyle="bold"
                    android:textColor="@color/home_text_primary" />
                <TextView android:id="@+id/Total" android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                    android:layout_marginStart="4dp" android:textSize="15sp" android:textColor="@color/home_text_secondary" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
                <include android:id="@+id/E2Stat" layout="@layout/asset_metric"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <include android:id="@+id/M3Stat" layout="@layout/asset_metric"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <include android:id="@+id/Module3Stat" layout="@layout/asset_metric"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
                <include android:id="@+id/R6Progress" layout="@layout/asset_rarity"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <include android:id="@+id/R5Progress" layout="@layout/asset_rarity"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <include android:id="@+id/R4Progress" layout="@layout/asset_rarity"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.card.MaterialCardView style="@style/CardViewContent" app:strokeWidth="0dp" android:layout_marginTop="@dimen/card_vertical_spacing" android:layout_marginBottom="@dimen/card_vertical_spacing">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="10dp" android:paddingVertical="4dp" android:gravity="center_vertical">
        <com.google.android.material.chip.Chip
            android:id="@+id/Filter" style="@style/Widget.ArkScreen.ActionChip"
            android:text="@string/filter"
            app:chipIcon="@drawable/ic_filter" app:chipIconVisible="true" />
        <com.google.android.material.chip.Chip
            android:id="@+id/MissingButton" style="@style/Widget.ArkScreen.ActionChip"
            android:layout_marginStart="4dp"
            android:text="@string/not_own" />
        <Space android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
        <com.google.android.material.chip.Chip
            android:id="@+id/ViewChanger" style="@style/Widget.ArkScreen.ActionChip"
            android:layout_marginStart="4dp"
            app:textStartPadding="0dp" app:textEndPadding="0dp"
            android:contentDescription="@string/change_view"
            app:chipIcon="@drawable/ic_grid" app:chipIconVisible="true" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <include android:id="@+id/MissingPanel" layout="@layout/fragment_char_not_own" android:visibility="gone" />
</LinearLayout>
