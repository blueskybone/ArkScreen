<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/Toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/real_time_data">
        <ImageButton
            android:id="@+id/RefreshButton"
            style="@style/ToolbarIconAction"
            android:src="@drawable/ic_function_refresh"
            android:contentDescription="@string/refresh" />
    </com.google.android.material.appbar.MaterialToolbar>
    <com.blueskybone.arkscreen.ui.common.view.StarterLoadingView
        android:id="@+id/Loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/Toolbar"
        android:visibility="gone" />
    <androidx.core.widget.NestedScrollView
        android:id="@+id/ScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/Toolbar"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="16dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <include
                android:id="@+id/Profile"
                layout="@layout/card_realtime_profile" />
            <com.google.android.material.card.MaterialCardView
                style="@style/PageContentCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ap"
                                android:textAppearance="?attr/textAppearanceSubtitle1"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/ApFullTime"
                                style="@style/Widget.ArkScreen.StatusCapsule.Accent"
                                android:layout_marginTop="5dp" />
                            <TextView
                                android:id="@+id/ApResTime"
                                style="@style/Widget.ArkScreen.MetadataCapsule"
                                android:layout_marginTop="5dp" />
                        </LinearLayout>
                        <FrameLayout
                            android:layout_width="96dp"
                            android:layout_height="96dp">
                            <com.mikhaellopez.circularprogressbar.CircularProgressBar
                                android:id="@+id/CircularProgressBar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:cpb_background_progressbar_color="@color/realtime_progress_track"
                                app:cpb_background_progressbar_width="6dp"
                                app:cpb_progress_direction="to_right"
                                app:cpb_progressbar_color="?attr/colorPrimary"
                                app:cpb_progressbar_width="6dp"
                                app:cpb_round_border="true" />
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="bottom"
                                android:orientation="horizontal">
                                <TextView
                                    android:id="@+id/Ap"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="-"
                                    android:textAppearance="?attr/textAppearanceBody1"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textStyle="bold" />
                                <TextView
                                    android:id="@+id/ApMax"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="/-"
                                    android:textAppearance="?attr/textAppearanceBody1"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="12dp"
                        android:background="?android:attr/listDivider" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/realtime_daily_mission"
                                android:textAppearance="?attr/textAppearanceCaption"
                                android:textColor="?android:attr/textColorSecondary" />
                            <TextView
                                android:id="@+id/DailyValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:textAppearance="?attr/textAppearanceBody2"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/weekly_campaign"
                                android:textAppearance="?attr/textAppearanceCaption"
                                android:textColor="?android:attr/textColorSecondary" />
                            <TextView
                                android:id="@+id/CampaignValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:textAppearance="?attr/textAppearanceBody2"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/realtime_module_block"
                                android:textAppearance="?attr/textAppearanceCaption" />
                            <TextView
                                android:id="@+id/TowerHigherValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/TowerLowerValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                style="@style/PageContentCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:padding="12dp">
                    <include
                        android:id="@+id/Recruit"
                        layout="@layout/info_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="3dp" />
                    <include
                        android:id="@+id/RecruitReFresh"
                        layout="@layout/info_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp" />
                    <include
                        android:id="@+id/Labor"
                        layout="@layout/info_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp"
                        android:layout_marginEnd="3dp" />
                    <include
                        android:id="@+id/Meeting"
                        layout="@layout/info_card"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/Base"
                style="@style/PageContentCard">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">
                        <include
                            android:id="@+id/Manufactures"
                            layout="@layout/info_card_compact"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1" />
                        <include
                            android:id="@+id/Trading"
                            layout="@layout/info_card_compact"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1" />
                        <include
                            android:id="@+id/Dormitories"
                            layout="@layout/info_card_compact"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1" />
                        <include
                            android:id="@+id/Tired"
                            layout="@layout/info_card_compact"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:layout_weight="1" />
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="?android:attr/listDivider" />
                    <include
                        android:id="@+id/Train"
                        layout="@layout/item_realtime_training"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                    <LinearLayout
                        android:id="@+id/TrainChange"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone">
                        <TextView
                            android:id="@+id/Logos"
                            style="@style/Widget.ArkScreen.MetadataCapsule.Supporting"
                            android:layout_gravity="start"
                            android:visibility="gone" />
                        <Space
                            android:layout_width="match_parent"
                            android:layout_height="5dp" />
                        <TextView
                            android:id="@+id/Irene"
                            style="@style/Widget.ArkScreen.MetadataCapsule.Supporting"
                            android:layout_gravity="start"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout
                android:id="@+id/Starter"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:visibility="gone"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="8dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/realtime_divider" />
                <LinearLayout
                    android:layout_width="76dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_starter" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-2dp"
                        android:text="@string/start_game"
                        android:textColor="@color/tool_game_icon"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/realtime_divider" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <FrameLayout
        android:id="@+id/Page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/Toolbar"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/empty_content_padding">
            <include
                android:id="@+id/FallbackAccount"
                layout="@layout/card_account_selector" />
            <ImageView
                android:id="@+id/StatusIllustration"
                style="@style/Widget.ArkScreen.EmptyIllustration"
                android:src="@mipmap/ic_rosm" />
            <TextView
                android:id="@+id/Message"
                style="@style/Widget.ArkScreen.EmptyTitle" />
            <TextView
                android:id="@+id/EmptySummary"
                style="@style/Widget.ArkScreen.EmptySummary"
                android:text="@string/realtime_empty_summary"
                android:visibility="gone" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/EmptyAction"
                style="@style/Widget.ArkScreen.EmptyAction"
                android:text="@string/go_add_account"
                android:visibility="gone"
                app:icon="@drawable/ic_add" />
        </LinearLayout>
    </FrameLayout>
</RelativeLayout>
