<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp"
    android:gravity="center_vertical" android:orientation="horizontal"
    android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true">
    <TextView android:id="@+id/Server" style="@style/Widget.ArkScreen.CompactCapsule"
        android:layout_marginEnd="6dp" android:visibility="gone" />
    <TextView android:id="@+id/CurrentAccount" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textSize="15sp"
        android:textStyle="bold" android:textColor="@color/home_text_primary" />
    <ImageView android:layout_width="14dp" android:layout_height="16dp" android:layout_marginStart="6dp"
        android:src="@drawable/ic_function_select" app:tint="@color/home_text_secondary" android:contentDescription="@null" />
</LinearLayout>
