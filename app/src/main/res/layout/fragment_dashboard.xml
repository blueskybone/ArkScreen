<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="?attr/actionBarSize">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/TextView.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/function" />

        <com.google.android.material.card.MaterialCardView
            style="@style/CardViewContent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/RecruitHeader"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        style="@style/PreferenceHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="4dp"
                        android:text="@string/quick_recruit" />

                    <TextView
                        android:id="@+id/RecruitStatus"
                        style="@style/Widget.ArkScreen.StatusChip" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/RecruitExpand"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:rotation="90"
                        android:src="@drawable/ic_right_arrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/RecruitContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingBottom="4dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/OverlayPermissionChip"
                            style="@style/Widget.ArkScreen.SectionAction.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="@string/check_permission"
                            app:icon="@drawable/ic_permission" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/RecruitVideo"
                            style="@style/Widget.ArkScreen.SectionAction.Outlined"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:text="@string/recruit_video"
                            app:icon="@drawable/ic_play_circle" />
                    </LinearLayout>

                    <include android:id="@+id/RecruitMode" layout="@layout/preference_value" />
                    <include
                        android:id="@+id/FloatWindowAppearance"
                        layout="@layout/preference"
                        android:visibility="gone" />
                    <include android:id="@+id/ScreenShotDelay" layout="@layout/preference_sub_value" />
                    <include
                        android:id="@+id/OverlayPermission"
                        layout="@layout/preference"
                        android:visibility="gone" />
                    <include
                        android:id="@+id/NotifyPermission"
                        layout="@layout/preference"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/CardViewContent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/WidgetHeader"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        style="@style/PreferenceHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="4dp"
                        android:text="@string/widget" />

                    <TextView
                        android:id="@+id/WidgetStatus"
                        style="@style/Widget.ArkScreen.StatusChip" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/WidgetExpand"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:rotation="90"
                        android:src="@drawable/ic_right_arrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/WidgetContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:paddingHorizontal="12dp"
                        android:paddingBottom="4dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/WidgetPermission"
                            style="@style/Widget.ArkScreen.SectionAction.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="@string/runtime_settings"
                            app:icon="@drawable/ic_permission" />

                        <ImageView
                            android:id="@+id/WidgetInfo"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_info"
                            android:visibility="gone" />
                    </LinearLayout>

                    <include android:id="@+id/PowerSavingMode" layout="@layout/preference_sub_switch" />
                    <include android:id="@+id/WidgetRefresh" layout="@layout/preference" />
                    <include android:id="@+id/WidgetAppearance" layout="@layout/preference_icon" />
                    <include
                        android:id="@+id/TurnOffBatteryOptimization"
                        layout="@layout/preference"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/CardViewContent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/AttendanceHeader"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <TextView
                        style="@style/PreferenceHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingEnd="4dp"
                        android:text="@string/auto_attendance" />

                    <TextView
                        android:id="@+id/AttendanceStatus"
                        style="@style/Widget.ArkScreen.StatusChip" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/AttendanceExpand"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:rotation="90"
                        android:src="@drawable/ic_right_arrow" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/AttendanceContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:paddingHorizontal="12dp"
                        android:paddingBottom="4dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/AttdPermission"
                            style="@style/Widget.ArkScreen.SectionAction.Tonal"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="@string/runtime_settings"
                            app:icon="@drawable/ic_permission" />
                    </LinearLayout>

                    <include android:id="@+id/BackAutoAtd" layout="@layout/preference_sub_switch" />
                    <include android:id="@+id/SetAtdTime" layout="@layout/preference_sub_value" />
                    <include
                        android:id="@+id/OpenAutoStartSettings"
                        layout="@layout/preference"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
