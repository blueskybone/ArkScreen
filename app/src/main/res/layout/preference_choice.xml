<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">
    <View
        style="@style/ListDivider"
        android:id="@+id/RowDivider"
        android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        style="@style/PreferenceRow">
        <TextView
            android:id="@+id/RowTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/PreferenceRowTitle" />
        <TextView
            android:id="@+id/RowValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="4dp"
            android:gravity="end"
            android:maxWidth="210dp"
            android:maxLines="2"
            android:textSize="14sp"
            app:drawableEndCompat="@drawable/ic_function_select"
            app:drawableTint="@color/app_text_secondary"
            style="@style/PreferenceRowValue" />
    </LinearLayout>
</LinearLayout>
