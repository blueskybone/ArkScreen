<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
        android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView android:id="@+id/Value" android:layout_width="wrap_content"
                android:layout_height="wrap_content"
        android:textColor="@color/home_text_primary" android:textSize="20sp" android:textStyle="bold" />
    <TextView android:id="@+id/Title" android:layout_width="wrap_content"
                android:layout_height="wrap_content"
        android:textColor="@color/home_text_secondary" android:textSize="12sp" />
</LinearLayout>
