<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="16dp" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp" android:layout_weight="1">
        <TextView android:id="@+id/GameSelector" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="?attr/textAppearanceHeadline6" android:textSize="25sp" android:textStyle="bold" />
        <ImageButton android:id="@+id/SwitchGame" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="2dp" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="@string/switch_game" android:padding="9dp" android:src="@drawable/ic_update" app:tint="?attr/colorPrimary" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/DefaultStartup" style="@style/Widget.ArkScreen.InlineAction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/set_default_startup_page" android:layout_marginEnd="16dp" />
</LinearLayout>
