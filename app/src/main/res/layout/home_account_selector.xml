<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/AccountSelectorBase"
    android:layout_width="wrap_content"
    android:background="@drawable/bg_home_account_selector"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <TextView
        android:id="@+id/AttendanceStatus"
        style="@style/Widget.ArkScreen.StatusCapsule"
        android:layout_marginEnd="6dp"
        android:visibility="gone" />
    <TextView
        android:id="@+id/Server"
        android:visibility="gone"
        style="@style/Widget.ArkScreen.MetadataCapsule"
        android:layout_marginEnd="6dp" />
    <TextView
        android:id="@+id/CurrentAccount"
        style="@style/AccountSelectorName" />
    <ImageView
        style="@style/AccountSelectorIndicator"
        android:layout_width="12dp"
        android:layout_height="16dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no" />
</LinearLayout>
