<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:minHeight="56dp"
    android:paddingStart="16dp"
    android:paddingTop="8dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp"
    android:background="?attr/selectableItemBackground"
    style="@style/AccountSelectorBase">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/Avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/RoundedImageView" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/Server"
                style="@style/Widget.ArkScreen.MetadataCapsule"
                android:layout_marginEnd="6dp" />
            <TextView
                android:id="@+id/CurrentAccount"
                android:layout_width="wrap_content"
                android:textAppearance="?attr/textAppearanceSubtitle1"
                style="@style/AccountSelectorName"
                android:layout_weight="0" />
        </LinearLayout>
        <TextView
            android:id="@+id/Subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
    <ImageView
        android:layout_width="16dp"
        android:contentDescription="@string/switch_account"
        style="@style/AccountSelectorIndicator"
        android:layout_height="16dp"
        android:layout_marginStart="0dp"
        android:importantForAccessibility="auto" />
</LinearLayout>
